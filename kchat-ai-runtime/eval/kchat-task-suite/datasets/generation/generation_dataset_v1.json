{
  "name": "kchat-generation-v1",
  "version": "1.0.0",
  "description": "Real generation tests with actual model inference — measures TTFT, decode rate, output quality, and grammar constraint compliance",
  "prompts": [
    {
      "id": "gen_001",
      "prompt": "Write a short greeting message to welcome a new team member.",
      "max_tokens": 128,
      "grammar": null,
      "expected_min_tokens": 10,
      "description": "Simple greeting generation"
    },
    {
      "id": "gen_002",
      "prompt": "Summarize the key points of OAuth 2.0 authentication in 3 bullet points.",
      "max_tokens": 256,
      "grammar": null,
      "expected_min_tokens": 30,
      "description": "Summarization task"
    },
    {
      "id": "gen_003",
      "prompt": "Generate a JSON object representing a user profile with fields: name (string), age (number), email (string), and active (boolean).",
      "max_tokens": 128,
      "grammar": {
        "type": "json_schema",
        "schema": {
          "type": "object",
          "required": ["name", "age", "email", "active"],
          "properties": {
            "name": { "type": "string" },
            "age": { "type": "number" },
            "email": { "type": "string" },
            "active": { "type": "boolean" }
          }
        }
      },
      "expected_min_tokens": 20,
      "description": "JSON Schema constrained generation"
    },
    {
      "id": "gen_004",
      "prompt": "Translate 'Hello, how are you?' into Vietnamese, Thai, and Japanese.",
      "max_tokens": 128,
      "grammar": null,
      "expected_min_tokens": 10,
      "description": "Multilingual translation"
    },
    {
      "id": "gen_005",
      "prompt": "Write a Python function that checks if a string is a palindrome. Include a docstring.",
      "max_tokens": 256,
      "grammar": null,
      "expected_min_tokens": 30,
      "description": "Code generation"
    },
    {
      "id": "gen_006",
      "prompt": "Generate a JSON array of 3 task objects, each with id (number), title (string), and completed (boolean).",
      "max_tokens": 256,
      "grammar": {
        "type": "json_schema",
        "schema": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "title", "completed"],
            "properties": {
              "id": { "type": "number" },
              "title": { "type": "string" },
              "completed": { "type": "boolean" }
            }
          }
        }
      },
      "expected_min_tokens": 30,
      "description": "JSON array with schema constraint"
    },
    {
      "id": "gen_007",
      "prompt": "Explain what SQL injection is and how to prevent it, in 2 paragraphs.",
      "max_tokens": 512,
      "grammar": null,
      "expected_min_tokens": 50,
      "description": "Security explanation"
    },
    {
      "id": "gen_008",
      "prompt": "Write a haiku about the ocean.",
      "max_tokens": 64,
      "grammar": null,
      "expected_min_tokens": 5,
      "description": "Creative writing, short output"
    },
    {
      "id": "gen_009",
      "prompt": "Generate a JSON object for a calendar event with title, start_time (ISO format), duration_minutes, and attendees (array of strings).",
      "max_tokens": 256,
      "grammar": {
        "type": "json_schema",
        "schema": {
          "type": "object",
          "required": ["title", "start_time", "duration_minutes", "attendees"],
          "properties": {
            "title": { "type": "string" },
            "start_time": { "type": "string" },
            "duration_minutes": { "type": "number" },
            "attendees": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      },
      "expected_min_tokens": 20,
      "description": "Complex JSON Schema with nested array"
    },
    {
      "id": "gen_010",
      "prompt": "List 5 best practices for writing clean code. One line each.",
      "max_tokens": 256,
      "grammar": null,
      "expected_min_tokens": 30,
      "description": "List generation"
    }
  ],
  "performance_targets": {
    "low_tier": {
      "ttft_p95_ms": 2500,
      "decode_p50_tps": 8,
      "max_memory_gb": 0.75
    },
    "medium_tier": {
      "ttft_p95_ms": 1500,
      "decode_p50_tps": 15,
      "max_memory_gb": 1.5
    },
    "high_tier": {
      "ttft_p95_ms": 1000,
      "decode_p50_tps": 25,
      "max_memory_gb": 3.0
    }
  }
}
